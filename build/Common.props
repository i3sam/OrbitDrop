<Project>
  <!-- Shared settings for src/ and tests/ (the Orbit Probe experiment stays independent). -->
  <PropertyGroup>
    <OrbitWindowsTfm>net10.0-windows10.0.19041.0</OrbitWindowsTfm>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.4.9-alpha</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>OrbitDrop</Product>
    <Company>OrbitDrop contributors</Company>
    <Authors>OrbitDrop contributors</Authors>
    <Copyright>© 2026 Mohammed Essam and OrbitDrop contributors · MIT License</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- WPF Fluent ThemeMode is marked experimental in .NET 10; usage is isolated in ThemeManager. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
</Project>
